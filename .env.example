# Optional 32-byte mesh key, base64. This file is only a template.
# Copy it to .env and fill in the key. .env is not committed.
# Devices without a stored key adopt this key on first boot. The key is readable from the built
# binary, so never publish firmware built with it. Leave empty to set the key on the settings page.
# Generate: openssl rand -base64 32
MESH_PSK_B64=
